# Salin ke backend/.env lalu isi nilainya. File .env tidak di-commit.
PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=pantau
MONGODB_DB=pantau
# Pisahkan dengan koma. Di production ganti dengan URL Netlify.
ALLOWED_ORIGINS=http://localhost:5173
GIN_MODE=debug
